{% extends "_layouts/cp" %}
{% set title = "Confirm your identity" %}
{# CSP: defense in depth against embedded-iframe consent attacks. #}
{% set noindex = true %}
{% header "Content-Security-Policy: frame-ancestors 'none'" %}
{% header "X-Frame-Options: DENY" %}

{% block content %}
<div class="content-pane">
    <h1>Confirm your identity</h1>

    <p>You are signed in as <strong>{{ user.username }}</strong>, but the
    following permissions are marked <em>high-trust</em> and require you to
    re-enter your password:</p>

    <ul class="bullets">
        {% for s in highStakes %}
            <li><strong>{{ s }}</strong></li>
        {% endfor %}
    </ul>

    {% if error %}
        <p class="error" style="color:#c00;">{{ error }}</p>
    {% endif %}

    <form method="post" action="{{ siteUrl('oauth/elevate') }}">
        {{ csrfInput() }}
        <input type="hidden" name="continuationUrl" value="{{ continuationUrl }}">

        <div class="field" style="max-width:24em;">
            <label for="mcp-elevate-password">Password</label>
            <input id="mcp-elevate-password" type="password" name="password"
                   required autofocus autocomplete="current-password" class="text fullwidth">
        </div>

        <div class="buttons" style="margin-top:1em;">
            <button type="submit" class="btn submit">Continue</button>
            <a class="btn" href="{{ cpUrl() }}">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
